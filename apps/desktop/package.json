{
  "name": "@axterm/desktop",
  "version": "0.10.0",
  "private": true,
  "type": "module",
  "description": "Axterm desktop host and terminal workspace",
  "author": "Axterm contributors",
  "desktopName": "axterm",
  "homepage": "https://github.com/yogasamadhi/axterm",
  "license": "Apache-2.0",
  "main": "lib/shell/main.js",
  "scripts": {
    "dev": "node ../../scripts/dev-desktop.mjs",
    "build": "node ../../scripts/build-level3-shell.mjs",
    "package": "node ../../scripts/package-desktop.mjs --product",
    "package:dir": "node ../../scripts/package-desktop.mjs --product --dir"
  },
  "dependencies": {
    "@axterm/web": "workspace:*",
    "@axterm/desktop-host": "workspace:*",
    "@axterm/infra-connection": "workspace:*",
    "@axterm/infra-desktop-native": "workspace:*",
    "@axterm/infra-credential-vault": "workspace:*",
    "@axterm/infra-profile-recovery": "workspace:*",
    "@axterm/plugin-api": "workspace:*"
  },
  "devDependencies": {
    "electron": "44.3.0",
    "electron-builder": "26.16.1"
  },
  "axterm": {
    "migrationValidation": true
  }
}

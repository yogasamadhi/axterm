    "assets:check": "node scripts/commercialization/generate-product-asset-inventory.mjs --check",
    "assets:marks:generate": "node scripts/commercialization/product-asset-review-ledger.mjs --generate",
    "assets:marks:check": "node scripts/commercialization/product-asset-review-ledger.mjs --check",
    "assets:marks:reviewed-check": "node scripts/commercialization/product-asset-review-ledger.mjs --reviewed-check",

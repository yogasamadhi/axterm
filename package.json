    "licenses:napi:source-check": "node scripts/commercialization/verify-napi-rs-root-license.mjs --source-check",
    "licenses:novnc:generate": "node scripts/commercialization/generate-novnc-source-notices.mjs --generate",
    "licenses:novnc:check": "node scripts/commercialization/generate-novnc-source-notices.mjs --check",
    "licenses:novnc:bundle-check": "node scripts/commercialization/generate-novnc-source-notices.mjs --bundle-check",

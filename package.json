{
  "name": "axterm",
  "version": "0.10.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "engines": {
    "node": ">=24.18.0 <25",
    "bun": ">=1.4.0 <1.5"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "node scripts/prepare-native.mjs",
    "dev": "bun run run.ts",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "node scripts/typecheck.mjs",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration",
    "test:ssh": "sh scripts/test-ssh-fixture.sh",
    "test:ssh:packaged": "AXTERM_PACKAGED_SSH=1 sh scripts/test-ssh-fixture.sh",
    "test:soak:smoke": "AXTERM_SOAK_DURATION_MS=60000 sh scripts/test-phase21-soak.sh",
    "test:soak:30m": "AXTERM_SOAK_DURATION_MS=1800000 sh scripts/test-phase21-soak.sh && node scripts/verify-phase21-soak.mjs",
    "test:soak:verify": "node scripts/verify-phase21-soak.mjs",
    "test:e2e": "bun run build && playwright test --project=desktop",
    "test:a11y": "bun run build && playwright test --project=accessibility",
    "test:performance": "bun run build && playwright test --project=performance",
    "test:packaged": "playwright test --project=packaged",
    "test:dmg:macos": "sh scripts/test-macos-dmg.sh",
    "architecture:check": "node scripts/architecture-check.mjs",
    "generate:electerm-themes": "node scripts/generate-electerm-themes.mjs",
    "locales:generate": "node scripts/localization/generate-electerm-locales.mjs",
    "locales:check": "node scripts/localization/generate-electerm-locales.mjs --check",
    "locales:audit": "node scripts/localization/audit-renderer.mjs",
    "locales:audit:update": "node scripts/localization/audit-renderer.mjs --write-baseline",
    "parity:audit": "node scripts/parity/audit.mjs --output test-results/parity-audit.json",
    "parity:prepare:electerm": "node scripts/parity/prepare-electerm-reference.mjs",
    "parity:capture:axterm": "bun run build && node scripts/parity/capture.mjs --target=axterm",
    "parity:capture:electerm": "node scripts/parity/capture.mjs --target=electerm",
    "parity:capture:phase16": "sh scripts/parity/capture-phase16.sh",
    "parity:capture:phase17": "sh scripts/parity/capture-phase17.sh",
    "parity:capture:phase18": "sh scripts/parity/capture-phase18.sh",
    "parity:capture:phase19": "sh scripts/parity/capture-phase19.sh",
    "parity:capture:phase20": "sh scripts/parity/capture-phase20.sh",
    "parity:capture:phase21": "sh scripts/parity/capture-phase21.sh",
    "parity:diff": "node scripts/parity/visual-diff.mjs --reference tests/parity/screenshots/electerm --candidate tests/parity/screenshots/axterm --output test-results/parity-diff",
    "parity:trace:audit": "node scripts/parity/trace-security.mjs --audit tests/parity/screenshots/axterm/traces tests/parity/screenshots/electerm/traces",
    "parity:trace:sanitize": "node scripts/parity/trace-security.mjs --sanitize tests/parity/screenshots/axterm/traces tests/parity/screenshots/electerm/traces",
    "parity:reference": "node scripts/parity/launch-electerm-reference.mjs",
    "openapi:generate": "bun scripts/contracts.ts openapi",
    "client:generate": "bun scripts/contracts.ts client",
    "contracts:check": "bun scripts/contracts.ts check",
    "build": "bun run --cwd apps/desktop build && bun run --cwd packages/runtime build && node scripts/packaging-check.mjs",
    "package": "bun run build && bun run --cwd apps/desktop package",
    "package:dir": "bun run build && bun run --cwd apps/desktop package:dir",
    "check": "bun run lint && bun run typecheck && bun run test && bun run architecture:check && bun run contracts:check && bun run locales:check && bun run locales:audit && bun run parity:audit && bun run build",
    "test:dev": "playwright test --project=dev"
  },
  "trustedDependencies": [
    "electron",
    "esbuild",
    "node-pty",
    "@serialport/bindings-cpp"
  ],
  "devDependencies": {
    "@electron/rebuild": "4.2.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.4",
    "@types/pngjs": "6.0.5",
    "@types/ssh2": "1.15.5",
    "@types/ws": "8.18.1",
    "dependency-cruiser": "18.2.0",
    "drizzle-kit": "0.31.10",
    "esbuild": "0.28.2",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "node-gyp": "12.4.0",
    "pixelmatch": "7.2.0",
    "pngjs": "7.0.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.0",
    "ws": "8.21.3"
  },
  "patchedDependencies": {
    "node-pty@1.1.0": "patches/node-pty@1.1.0.patch",
    "trzsz2@1.2.0": "patches/trzsz2@1.2.0.patch"
  }
}

    "locales:navigation:reviewed-check": "node scripts/localization/generate-axterm-navigation.mjs --reviewed-navigation-check",
    "locales:core:generate": "node scripts/localization/generate-axterm-core-review-ledger.mjs --generate",
    "locales:core:check": "node scripts/localization/generate-axterm-core-review-ledger.mjs --check",
    "locales:core:reviewed-check": "node scripts/localization/generate-axterm-core-review-ledger.mjs --reviewed-core-check",
    "locales:scope": "node scripts/localization/audit-legacy-ui-keys.mjs",
    "locales:draft": "node scripts/localization/generate-axterm-navigation.mjs",
    "locales:audit": "node scripts/localization/audit-renderer.mjs",
    "locales:audit:update": "node scripts/localization/audit-renderer.mjs --write-baseline",
    "openapi:generate": "bun scripts/contracts.ts openapi",
    "client:generate": "bun scripts/contracts.ts client",
    "contracts:check": "bun scripts/contracts.ts check",
    "build": "bun run pi:build && bun run --cwd apps/desktop build && bun run --cwd packages/runtime build && node scripts/packaging-check.mjs",
    "package": "bun run build && bun run --cwd apps/desktop package",
    "package:dir": "bun run build && bun run --cwd apps/desktop package:dir",
    "check": "bun run lint && bun run typecheck && bun run test && bun run architecture:check && bun run contracts:check && bun run licenses:components:check && bun run licenses:texts:check && bun run licenses:attribution:check && bun run licenses:native:check && bun run licenses:native:texts:check && bun run licenses:native:headers:check && bun run licenses:ironrdp:source:check && bun run licenses:ironrdp:missing:check && bun run licenses:ironrdp:nested:check && bun run licenses:ironrdp:headers:check && bun run licenses:ironrdp:review:check && bun run licenses:zstd:embedded:check && bun run licenses:napi:check && bun run licenses:novnc:check && bun run licenses:novnc:source-check && bun run licenses:spice:check && bun run licenses:spice:source-check && bun run sbom:check && bun run sbom:native:macos:check && bun run assets:check && bun run assets:marks:check && bun run source:review:check && bun run migration:record:check && bun run release:services:check && bun run release:updater-feed:check && bun run transition:boundaries:check && bun run locales:check && bun run locales:core:check && bun run locales:scope && bun run locales:draft && bun run locales:audit && bun run snapshot:check && bun run build && bun run licenses:novnc:bundle-check && bun run licenses:spice:bundle-check && playwright test --project=visual --project=accessibility",
    "test:dev": "playwright test --project=dev",
    "pi:build": "node scripts/build-pi-engine.mjs"
  },
  "trustedDependencies": [
    "electron",
    "esbuild",
    "node-pty",
    "@serialport/bindings-cpp"
  ],
  "devDependencies": {
    "@electron/rebuild": "4.2.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.4",
    "@types/pngjs": "6.0.5",
    "@types/ssh2": "1.15.5",
    "@types/ws": "8.18.1",
    "axe-core": "4.13.0",
    "cross-spawn": "7.0.6",
    "dependency-cruiser": "18.2.0",
    "drizzle-kit": "0.31.10",
    "esbuild": "0.28.2",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "ignore": "7.0.6",
    "node-gyp": "12.4.0",
    "pixelmatch": "7.2.0",
    "pngjs": "7.0.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.0",
    "ws": "8.21.3",
    "yaml": "2.9.0"
  },
  "overrides": {
    "esbuild": "0.28.2"
  },
  "patchedDependencies": {
    "node-pty@1.1.0": "patches/node-pty@1.1.0.patch",
    "trzsz2@1.2.0": "patches/trzsz2@1.2.0.patch"
  }
}

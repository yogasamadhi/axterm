    "licenses:native:texts:check": "node scripts/commercialization/native-root-license-bundle.mjs --check",
    "licenses:zstd:embedded:generate": "node scripts/commercialization/zstd-embedded-licenses.mjs --generate",
    "licenses:zstd:embedded:check": "node scripts/commercialization/zstd-embedded-licenses.mjs --check",

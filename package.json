    "licenses:ironrdp:missing:check": "node scripts/commercialization/ironrdp-missing-root-licenses.mjs --check",
    "licenses:ironrdp:missing:source-check": "node scripts/commercialization/ironrdp-missing-root-licenses.mjs --source-check",
    "licenses:ironrdp:nested:check": "node scripts/commercialization/ironrdp-nested-license.mjs --check",
    "licenses:ironrdp:nested:source-check": "node scripts/commercialization/ironrdp-nested-license.mjs --source-check",
    "licenses:ironrdp:headers:generate": "node scripts/commercialization/ironrdp-source-headers.mjs --generate",
    "licenses:ironrdp:headers:check": "node scripts/commercialization/ironrdp-source-headers.mjs --check",
    "licenses:ironrdp:headers:source-check": "node scripts/commercialization/ironrdp-source-headers.mjs --source-check",
    "licenses:ironrdp:review:generate": "node scripts/commercialization/ironrdp-dependency-review-ledger.mjs --generate",
    "licenses:ironrdp:review:check": "node scripts/commercialization/ironrdp-dependency-review-ledger.mjs --check",
    "licenses:ironrdp:review:reviewed-check": "node scripts/commercialization/ironrdp-dependency-review-ledger.mjs --reviewed-check",

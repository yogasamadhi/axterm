    "candidate:ssh:check": "node scripts/commercialization/check-ephemeral-git-candidate.mjs --check --ssh",
    "candidate:protocol:check": "node scripts/commercialization/check-ephemeral-git-candidate.mjs --check --ssh --external-peers",

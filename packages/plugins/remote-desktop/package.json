{
  "name": "@axterm/plugin-remote-desktop",
  "version": "0.10.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "browser": "./lib/client.browser.js",
      "default": "./lib/client.js"
    }
  },
  "files": [
    "lib",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "dependencies": {
    "@axterm/plugin-api": "workspace:*",
    "@axterm/infra-gateway": "workspace:*",
    "zod": "4.4.3",
    "@axterm/infra-credentials": "workspace:*",
    "@axterm/infra-web-server": "workspace:*",
    "@axterm/infra-connection": "workspace:*",
    "@axterm/infra-remote-access": "workspace:*",
    "ws": "8.21.3",
    "@axterm/ui": "workspace:*",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "lucide-react": "1.44.0",
    "@devolutions/iron-remote-desktop-rdp": "0.7.0",
    "@novnc/novnc": "1.7.0",
    "spice-client": "1.2.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  },
  "axterm": {
    "client": {
      "platform": "web",
      "immediately": true,
      "external": [
        "@axterm/infra-gateway/client"
      ]
    }
  },
  "devDependencies": {
    "vitest": "5.0.0",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7"
  }
}

{
  "name": "@axterm/infra-http-proxy",
  "description": "Process-wide outbound HTTP proxy policy for the application: resolve it from the launch environment and install it as undici's global dispatcher",
  "version": "0.10.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  },
  "dependencies": {
    "undici": "8.11.2"
  },
  "private": true,
  "scripts": {
    "build": "node ../../../scripts/build-level3.mjs"
  }
}

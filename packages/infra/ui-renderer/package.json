    "@deepseek-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@testing-library/react": "16.3.3",
    "@testing-library/dom": "10.4.2"
  }

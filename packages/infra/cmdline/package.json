{
  "name": "@axterm/infra-cmdline",
  "description": "Immutable command-line handoff from a axterm launcher to any app plugin that injects cmdlineArgs",
  "version": "0.10.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis-plugin-loader": "workspace:~",
    "@deepseek-ai/cordis": "workspace:~"
  },
  "private": true,
  "scripts": {
    "build": "node ../../../scripts/build-level3.mjs"
  },
  "devDependencies": {
    "commander": "15.0.0"
  }
}
